{
	"theme": "base",
	"fontFamily": "Poppins, sans-serif",
	"htmlLabels": false,
	"securityLevel": "strict",
	"flowchart": {
		"htmlLabels": false,
		"curve": "basis",
		"padding": 14,
		"nodeSpacing": 44,
		"rankSpacing": 52,
		"subGraphTitleMargin": {
			"top": 6,
			"bottom": 6
		}
	},
	"sequence": {
		"mirrorActors": true,
		"messageMargin": 32,
		"actorMargin": 36,
		"width": 132,
		"boxMargin": 8
	},
	"themeVariables": {
		"darkMode": false,
		"background": "#d9d9d9",
		"fontFamily": "Poppins, sans-serif",
		"fontSize": "14px",
		"primaryColor": "#ececec",
		"primaryTextColor": "#202221",
		"primaryBorderColor": "#202221",
		"secondaryColor": "#cdef33",
		"secondaryBorderColor": "#202221",
		"secondaryTextColor": "#202221",
		"tertiaryColor": "#d9d9d9",
		"tertiaryBorderColor": "#202221",
		"tertiaryTextColor": "#202221",
		"lineColor": "#202221",
		"textColor": "#202221",
		"mainBkg": "#ececec",
		"nodeBorder": "#202221",
		"clusterBkg": "#d9d9d9",
		"clusterBorder": "#202221",
		"titleColor": "#202221",
		"edgeLabelBackground": "#d9d9d9",
		"actorBkg": "#ececec",
		"actorBorder": "#202221",
		"actorTextColor": "#202221",
		"actorLineColor": "#202221",
		"signalColor": "#202221",
		"signalTextColor": "#202221",
		"labelBoxBkgColor": "#202221",
		"labelBoxBorderColor": "#202221",
		"labelTextColor": "#ececec",
		"loopTextColor": "#202221",
		"noteBkgColor": "#cdef33",
		"noteBorderColor": "#202221",
		"noteTextColor": "#202221",
		"activationBkgColor": "#ececec",
		"activationBorderColor": "#202221"
	},
	"themeCSS": ".cluster rect { stroke-dasharray: 4 3; } .edgeLabel rect { opacity: 1; }"
}
